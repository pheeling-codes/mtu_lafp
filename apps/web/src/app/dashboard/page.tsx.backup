            </div>
            <p className="text-3xl font-bold text-slate-900 mb-1">{stat.value}</p>
            <p className="text-sm text-slate-500">{stat.title}</p>
            <p className="text-xs text-slate-400 mt-2">{stat.subtitle}</p>
          </div>
        ))}
      </div>

      <div className="grid lg:grid-cols-3 gap-8">
        {/* Recent Activity */}
        <div className="lg:col-span-2">
          <div className="bg-white rounded-2xl border border-slate-200 shadow-sm">
            <div className="p-6 border-b border-slate-100 flex items-center justify-between">
              <h2 className="text-lg font-semibold text-slate-900">Recent Activity</h2>
              <Link href="/dashboard/lost" className="text-sm text-[#2563EB] font-medium hover:underline flex items-center gap-1">
                View all <ArrowRight className="w-4 h-4" />
              </Link>
            </div>
            
            <div className="p-6">
              {recentItems.length === 0 ? (
                <div className="text-center py-12">
                  <div className="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <Sparkles className="w-8 h-8 text-slate-400" />
                  </div>
                  <p className="text-slate-500">No recent activity yet</p>
                  <p className="text-sm text-slate-400 mt-1">Report a lost or found item to get started</p>
                </div>
              ) : (
                <div className="space-y-4">
                  {/* Mock activity items based on the UI */}
                  <div className="flex items-start gap-4 p-4 bg-amber-50 rounded-xl border border-amber-100">
                    <div className="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center flex-shrink-0">
                      <AlertCircle className="w-5 h-5 text-amber-600" />
                    </div>
                    <div className="flex-1">
                      <p className="text-sm text-slate-900">
                        <span className="font-semibold">Potential match found</span> for your reported lost item <span className="font-medium">&quot;MacBook Pro 14-inch&quot;</span>.
                      </p>
                      <p className="text-xs text-slate-500 mt-1">2 hours ago</p>
                    </div>
                    <button className="text-sm font-medium text-[#2563EB] hover:underline whitespace-nowrap">
                      Review Match
                    </button>
                  </div>

                  <div className="flex items-start gap-4 p-4 bg-emerald-50 rounded-xl border border-emerald-100">
                    <div className="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center flex-shrink-0">
                      <CheckCircle className="w-5 h-5 text-emerald-600" />
                    </div>
                    <div className="flex-1">
                      <p className="text-sm text-slate-900">
                        <span className="font-semibold">Claim approved!</span> You can now pick up your <span className="font-medium">&quot;Hydro Flask Water Bottle&quot;</span> from the central security desk.
                      </p>
                      <p className="text-xs text-slate-500 mt-1">Yesterday at 4:30 PM</p>
                    </div>
                    <button className="text-sm font-medium text-[#2563EB] hover:underline whitespace-nowrap">
                      View Instructions
                    </button>
                  </div>

                  <div className="flex items-start gap-4 p-4 bg-slate-50 rounded-xl border border-slate-100">
                    <div className="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                      <Clock className="w-5 h-5 text-blue-600" />
                    </div>
                    <div className="flex-1">
                      <p className="text-sm text-slate-900">
                        <span className="font-semibold">New report submitted.</span> You reported a lost <span className="font-medium">&quot;MacBook Pro 14-inch&quot;</span> at the Library.
                      </p>
                      <p className="text-xs text-slate-500 mt-1">Oct 12, 2023</p>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>

        {/* Quick Actions */}
        <div>
          <div className="bg-white rounded-2xl border border-slate-200 shadow-sm">
            <div className="p-6 border-b border-slate-100">
              <h2 className="text-lg font-semibold text-slate-900">Quick Actions</h2>
            </div>
            
            <div className="p-6 space-y-4">
              <Link 
                href="/dashboard/found"
                className="flex items-start gap-4 p-4 rounded-xl border border-slate-200 hover:border-[#2563EB] hover:shadow-md transition-all group"
              >
                <div className="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center group-hover:bg-[#2563EB] transition-colors">
                  <Search className="w-6 h-6 text-[#2563EB] group-hover:text-white transition-colors" />
                </div>
                <div className="flex-1">
                  <h3 className="font-semibold text-slate-900">Browse Found Items</h3>
                  <p className="text-sm text-slate-500 mt-0.5">Search through items turned in.</p>
                </div>
                <ArrowRight className="w-5 h-5 text-slate-400 group-hover:text-[#2563EB] transition-colors" />
              </Link>

              <Link 
                href="#"
                className="flex items-start gap-4 p-4 rounded-xl border border-slate-200 hover:border-[#2563EB] hover:shadow-md transition-all group"
              >
                <div className="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center group-hover:bg-[#2563EB] transition-colors">
                  <MapPin className="w-6 h-6 text-purple-600 group-hover:text-white transition-colors" />
                </div>
                <div className="flex-1">
                  <h3 className="font-semibold text-slate-900">Drop-off Points</h3>
