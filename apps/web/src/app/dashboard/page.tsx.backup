'use client';

import { useAuth } from '@/components/AuthProvider';
import { supabaseClient } from '@/utils/supabaseClient';
import { useEffect, useState } from 'react';
import { 
  Search, 
  PackageOpen, 
  GitPullRequest, 
  FileText,
  ArrowRight,
  Clock,
  CheckCircle,
  AlertCircle,
  Plus,
  MapPin,
  Sparkles
} from 'lucide-react';
import Link from 'next/link';

// Debug component to diagnose auth issues
function AuthDebugPanel() {
  const { user, isLoading, role } = useAuth();
  const [cookies, setCookies] = useState<string>('');
  
  useEffect(() => {
    setCookies(document.cookie);
  }, []);
  
  return (
    <div className="fixed top-0 left-0 right-0 z-50 bg-yellow-100 border-b-2 border-yellow-500 p-4 font-mono text-sm">
      <div className="max-w-7xl mx-auto">
        <h3 className="font-bold text-yellow-800 mb-2">🔍 Auth Debug Panel</h3>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div>
            <span className="text-yellow-700 font-semibold">isLoading:</span>{' '}
            <span className={isLoading ? 'text-red-600' : 'text-green-600'}>
              {isLoading ? 'TRUE ⚠️' : 'false ✓'}
            </span>
          </div>
          <div>
            <span className="text-yellow-700 font-semibold">hasUser:</span>{' '}
            <span className={user ? 'text-green-600' : 'text-red-600'}>
              {user ? 'TRUE ✓' : 'FALSE ⚠️'}
            </span>
          </div>
          <div>
            <span className="text-yellow-700 font-semibold">role:</span>{' '}
            <span className={role ? 'text-green-600' : 'text-red-600'}>
              {role || 'NULL ⚠️'}
            </span>
          </div>
          <div>
            <span className="text-yellow-700 font-semibold">userId:</span>{' '}
            <span className="text-blue-600">
              {user?.id?.slice(0, 8) || 'NONE'}...
            </span>
          </div>
        </div>
        <div className="mt-2 text-xs text-yellow-700">
          <strong>Cookies:</strong> {cookies.includes('sb-') ? '✓ Session cookie found' : '✗ No session cookie'} 
          {' | '}
          {cookies.includes('user-role') ? `✓ Role cookie: ${cookies.match(/user-role=([^;]+)/)?.[1]}` : '✗ No role cookie'}
        </div>
      </div>
    </div>
  );
}

function useDashboardData(userId: string | undefined) {
  const [data, setData] = useState({
    lostItemsCount: 0,
    foundItemsCount: 0,
    matchesCount: 0,
    claimsCount: 0,
    recentItems: [],
    loading: true,
  });

  useEffect(() => {
    if (!userId) {
      setData(prev => ({ ...prev, loading: false }));
      return;
    }

    async function fetchData() {
      if (!userId) return;
      
      // Get lost items count (items reported by user with type LOST)
      const { count: lostItemsCount } = await supabaseClient
        .from('items')
        .select('*', { count: 'exact', head: true })
        .eq('reporter_id', userId as string)
        .eq('type', 'LOST')
        .eq('status', 'OPEN');

      // Get found items count (recent found items on campus)
      const { count: foundItemsCount } = await supabaseClient
        .from('items')
        .select('*', { count: 'exact', head: true })
        .eq('type', 'FOUND')
        .eq('status', 'OPEN');

      // Get high-confidence matches count (score > 0.7)
      const { count: matchesCount } = await supabaseClient
        .from('matches')
        .select('*', { count: 'exact', head: true })
        .gte('score', 0.7)
        .eq('status', 'PENDING');

      // Get active claims count
      const { count: claimsCount } = await supabaseClient
        .from('claims')
        .select('*', { count: 'exact', head: true })
        .eq('seeker_id', userId as string)
        .eq('status', 'PENDING');

      // Get recent activity (last 5 items)
      const { data: recentItems } = await supabaseClient
        .from('items')
        .select('*, categories(name), locations(name)')
        .eq('reporter_id', userId as string)
        .order('created_at', { ascending: false })
        .limit(5);

      setData({
        lostItemsCount: lostItemsCount || 0,
        foundItemsCount: foundItemsCount || 0,
        matchesCount: matchesCount || 0,
        claimsCount: claimsCount || 0,
        recentItems: recentItems || [],
        loading: false,
      });
    }

    fetchData();
  }, [userId]);

  return data;
}

export default function DashboardPage() {
  const { user, role, isLoading: authLoading } = useAuth();
  const [profile, setProfile] = useState<{ full_name: string } | null>(null);

  // Consider authenticated if we have user OR role (role cookie fallback)
  const isAuthenticated = !!user || !!role;

  useEffect(() => {
    if (user?.id) {
      supabaseClient
        .from('profiles')
        .select('full_name')
        .eq('id', user.id)
        .single()
        .then(({ data }) => setProfile(data));
    }
  }, [user?.id]);

  const { 
    lostItemsCount, 
    foundItemsCount, 
    matchesCount, 
    claimsCount,
    recentItems,
    loading: dataLoading
  } = useDashboardData(user?.id);

  // Loading state - only show if auth is still loading
  if (authLoading) {
    return (
      <div className="min-h-screen bg-slate-50 flex items-center justify-center">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-[#2563EB] mx-auto"></div>
          <p className="mt-4 text-slate-600">Loading dashboard...</p>
        </div>
      </div>
    );
  }

  // Not authenticated
  if (!isAuthenticated) {
    return (
      <div className="min-h-screen bg-slate-50 flex items-center justify-center">
        <div className="text-center">
          <div className="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span className="text-2xl">🔒</span>
          </div>
          <h2 className="text-xl font-semibold text-slate-900 mb-2">Authentication Required</h2>
          <p className="text-slate-500 mb-4">Please sign in to view your dashboard.</p>
          <a
            href="/login"
            className="inline-flex items-center gap-2 px-4 py-2 bg-[#2563EB] text-white rounded-xl hover:bg-[#1d4ed8] transition-colors"
          >
            Sign In
          </a>
        </div>
      </div>
    );
  }

  // Use profile name, or user metadata, or role-based default
  const userName = profile?.full_name?.split(' ')[0] 
    || user?.user_metadata?.full_name?.split(' ')[0]
    || (role === 'ADMIN' ? 'Admin' : 'Student');

  const stats = [
    {
      title: 'Lost Items Reported',
      value: lostItemsCount,
      subtitle: '1 currently active',
      icon: <Search className="w-5 h-5" />,
      trend: null,
      color: 'blue',
    },
    {
      title: 'Found Items Nearby',
      value: foundItemsCount,
      subtitle: '+3 this week',
      icon: <PackageOpen className="w-5 h-5" />,
      trend: 'up',
      color: 'emerald',
    },
    {
      title: 'Potential Matches',
      value: matchesCount,
      subtitle: 'Requires your review',
      icon: <GitPullRequest className="w-5 h-5" />,
      trend: null,
      color: 'amber',
    },
    {
      title: 'Active Claims',
      value: claimsCount,
      subtitle: 'Pending admin review',
      icon: <FileText className="w-5 h-5" />,
      trend: null,
      color: 'purple',
    },
  ];

  const getColorClasses = (color: string) => {
    const colors: Record<string, string> = {
      blue: 'bg-blue-50 text-blue-600',
      emerald: 'bg-emerald-50 text-emerald-600',
      amber: 'bg-amber-50 text-amber-600',
      purple: 'bg-purple-50 text-purple-600',
    };
    return colors[color] || colors.blue;
  };

  return (
    <>
      <AuthDebugPanel />
      <div className="p-8 max-w-7xl mx-auto pt-24">
        {/* Header */}
      <div className="flex items-center justify-between mb-8">
        <div>
          <h1 className="text-2xl font-bold text-slate-900">Welcome back, {userName}</h1>
          <p className="text-slate-500 mt-1">Here&apos;s an overview of your lost and found activities.</p>
        </div>
        <Link
          href="/dashboard/report"
          className="bg-[#2563EB] text-white px-5 py-2.5 rounded-xl font-medium hover:bg-[#1d4ed8] transition-all flex items-center gap-2"
        >
          <Plus className="w-4 h-4" />
          Report Item
        </Link>
      </div>

      {/* Stats Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        {stats.map((stat, index) => (
          <div 
            key={index}
            className="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow"
          >
            <div className="flex items-start justify-between mb-4">
              <div className={`w-10 h-10 rounded-xl flex items-center justify-center ${getColorClasses(stat.color)}`}>
                {stat.icon}
