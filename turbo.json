{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "DATABASE_URL",
        "DIRECT_URL",
        "SUPABASE_JWT_SECRET",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "setup": {
      "cache": false,
      "outputs": ["dist/**", "node_modules/.prisma/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL"
      ]
    },
    "dev": {
      "dependsOn": ["^setup"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
